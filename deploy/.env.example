# Copy to .env and replace every CHANGE_ME value. Never commit .env.
POSTGRES_DB=advanta
POSTGRES_USER=advanta
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://advanta:CHANGE_ME@postgres:5432/advanta

REDIS_URL=redis://redis:6379/0

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=ad-clicks
KAFKA_DLQ_TOPIC=ad-clicks-dlq
KAFKA_GROUP_ID=aggregator

# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
CLICK_IP_HMAC_SECRET=CHANGE_ME

# Same-origin through nginx needs no CORS; list extra origins comma-separated if needed.
CORS_ORIGINS=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
