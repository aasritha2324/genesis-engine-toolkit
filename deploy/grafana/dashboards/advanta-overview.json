{"title": "AdVanta — Pipeline & Infrastructure", "uid": "advanta-overview", "tags": ["advanta"], "timezone": "utc", "refresh": "10s", "time": {"from": "now-30m", "to": "now"}, "templating": {"list": [{"name": "instance", "label": "Instance", "type": "query", "datasource": "Prometheus", "query": "label_values(up{job=~\"api|aggregator\"}, instance)", "includeAll": true, "current": {"text": "All", "value": "$__all"}}]}, "panels": [{"type": "row", "title": "Business", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "id": 100}, {"type": "timeseries", "title": "Clicks ingested (rate/s, all API replicas)", "datasource": "Prometheus", "gridPos": {"h": 7, "w": 8, "x": 0, "y": 1}, "id": 1, "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"fillOpacity": 15}}, "overrides": []}, "targets": [{"expr": "sum(rate(clicks_ingested_total[$__rate_interval]))", "legendFormat": "ingested/s"}]}, {"type": "timeseries", "title": "Rejected by reason (rate/s)", "datasource": "Prometheus", "gridPos": {"h": 7, "w": 8, "x": 8, "y": 1}, "id": 2, "targets": [{"expr": "sum(rate(clicks_rejected_total[$__rate_interval])) by (reason)", "legendFormat": "{{reason}}"}]}, {"type": "timeseries", "title": "Unique viewers this minute (HyperLogLog estimate)", "datasource": "Prometheus", "gridPos": {"h": 7, "w": 8, "x": 16, "y": 1}, "id": 3, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "targets": [{"expr": "max(unique_viewers_current_minute)", "legendFormat": "viewers/min"}]}, {"type": "row", "title": "API", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 8}, "id": 101}, {"type": "timeseries", "title": "API requests by status (rate/s)", "datasource": "Prometheus", "gridPos": {"h": 7, "w": 8, "x": 0, "y": 9}, "id": 4, "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}, "targets": [{"expr": "sum(rate(http_requests_total{job=\"api\",instance=~\"$instance\"}[$__rate_interval])) by (status)", "legendFormat": "{{status}}"}]}, {"type": "timeseries", "title": "API latency p50 / p95 / p99", "datasource": "Prometheus", "gridPos": {"h": 7, "w": 8, "x": 8, "y": 9}, "id": 5, "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "targets": [{"expr": "histogram_quantile(0.50, sum(rate(http_request_seconds_bucket{job=\"api\",instance=~\"$instance\"}[$__rate_interval])) by (le))", "legendFormat": "p50"}, {"expr": "histogram_quantile(0.95, sum(rate(http_request_seconds_bucket{job=\"api\",instance=~\"$instance\"}[$__rate_interval])) by (le))", "legendFormat": "p95"}, {"expr": "histogram_quantile(0.99, sum(rate(http_request_seconds_bucket{job=\"api\",instance=~\"$instance\"}[$__rate_interval])) by (le))", "legendFormat": "p99"}]}, {"type": "timeseries", "title": "Kafka publish time p95 (API)", "datasource": "Prometheus", "gridPos": {"h": 7, "w": 8, "x": 16, "y": 9}, "id": 6, "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "targets": [{"expr": "histogram_quantile(0.95, sum(rate(kafka_publish_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])) by (le))", "legendFormat": "p95"}]}, {"type": "stat", "title": "API errors (5m)", "datasource": "Prometheus", "gridPos": {"h": 4, "w": 6, "x": 0, "y": 16}, "id": 7, "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}, "targets": [{"expr": "sum(increase(errors_total{component=\"api\"}[5m]))", "legendFormat": "errors"}]}, {"type": "stat", "title": "4xx / 5xx share (1m)", "datasource": "Prometheus", "gridPos": {"h": 4, "w": 6, "x": 6, "y": 16}, "id": 8, "fieldConfig": {"defaults": {"unit": "percent", "max": 100}, "overrides": []}, "targets": [{"expr": "100 * sum(rate(http_requests_total{job=\"api\",status=~\"4..|5..\"}[$__rate_interval])) / sum(rate(http_requests_total{job=\"api\"}[$__rate_interval]))", "legendFormat": "errors %"}]}, {"type": "timeseries", "title": "Events in flight: accepted vs aggregated (rate/s)", "datasource": "Prometheus", "gridPos": {"h": 4, "w": 12, "x": 12, "y": 16}, "id": 9, "targets": [{"expr": "sum(rate(clicks_ingested_total[$__rate_interval]))", "legendFormat": "accepted"}, {"expr": "sum(rate(events_processed_total[$__rate_interval]))", "legendFormat": "aggregated"}]}, {"type": "row", "title": "Aggregator workers", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 20}, "id": 102}, {"type": "timeseries", "title": "Consumer lag by partition (messages)", "datasource": "Prometheus", "gridPos": {"h": 7, "w": 12, "x": 0, "y": 21}, "id": 10, "targets": [{"expr": "sum(kafka_consumer_lag) by (partition, instance)", "legendFormat": "{{instance}} p{{partition}}"}]}, {"type": "timeseries", "title": "Batch processing p95 and size", "datasource": "Prometheus", "gridPos": {"h": 7, "w": 12, "x": 12, "y": 21}, "id": 11, "fieldConfig": {"defaults": {"custom": {"scaleDistribution": {"type": "symlog"}}}, "overrides": []}, "targets": [{"expr": "histogram_quantile(0.95, sum(rate(batch_seconds_bucket[$__rate_interval])) by (le))", "legendFormat": "batch p95 (s)"}, {"expr": "sum(rate(batch_size_sum[$__rate_interval])) / sum(rate(batch_size_count[$__rate_interval]))", "legendFormat": "avg batch size"}]}, {"type": "timeseries", "title": "Duplicates dropped by layer (rate/s)", "datasource": "Prometheus", "gridPos": {"h": 7, "w": 8, "x": 0, "y": 28}, "id": 12, "targets": [{"expr": "sum(rate(duplicates_dropped_total[$__rate_interval])) by (layer)", "legendFormat": "{{layer}}"}]}, {"type": "timeseries", "title": "Late events / discarded (>24h)", "datasource": "Prometheus", "gridPos": {"h": 7, "w": 8, "x": 8, "y": 28}, "id": 13, "targets": [{"expr": "sum(rate(late_events_total[$__rate_interval]))", "legendFormat": "late"}, {"expr": "sum(rate(discarded_events_total[$__rate_interval]))", "legendFormat": "too_old"}]}, {"type": "timeseries", "title": "DLQ poison messages by reason", "datasource": "Prometheus", "gridPos": {"h": 7, "w": 8, "x": 16, "y": 28}, "id": 14, "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": null}]}}, "overrides": []}, "targets": [{"expr": "sum(rate(dlq_events_total[$__rate_interval])) by (reason)", "legendFormat": "{{reason}}"}]}, {"type": "timeseries", "title": "Fraud detections by rule (rate/s)", "datasource": "Prometheus", "gridPos": {"h": 7, "w": 8, "x": 0, "y": 35}, "id": 15, "targets": [{"expr": "sum(rate(fraud_detections_total[$__rate_interval])) by (rule)", "legendFormat": "{{rule}}"}]}, {"type": "timeseries", "title": "Aggregator errors (rate/s)", "datasource": "Prometheus", "gridPos": {"h": 7, "w": 8, "x": 8, "y": 35}, "id": 16, "targets": [{"expr": "sum(rate(errors_total{component=\"aggregator\"}[$__rate_interval])) by (kind)", "legendFormat": "{{kind}}"}]}, {"type": "stat", "title": "Partitions assigned / 6", "datasource": "Prometheus", "gridPos": {"h": 7, "w": 8, "x": 16, "y": 35}, "id": 17, "targets": [{"expr": "sum(assigned_partitions)", "legendFormat": "assigned"}]}, {"type": "row", "title": "Infrastructure", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 42}, "id": 103}, {"type": "timeseries", "title": "Kafka brokers online", "datasource": "Prometheus", "gridPos": {"h": 7, "w": 8, "x": 0, "y": 43}, "id": 18, "fieldConfig": {"defaults": {"min": 0}, "overrides": []}, "targets": [{"expr": "kafka_brokers", "legendFormat": "brokers"}]}, {"type": "timeseries", "title": "Kafka topic partitions", "datasource": "Prometheus", "gridPos": {"h": 7, "w": 8, "x": 8, "y": 43}, "id": 19, "targets": [{"expr": "sum(kafka_topic_partitions{topic=~\"ad-clicks.*\"}) by (topic)", "legendFormat": "{{topic}}"}]}, {"type": "timeseries", "title": "Consumer group lag (kafka-exporter)", "datasource": "Prometheus", "gridPos": {"h": 7, "w": 8, "x": 16, "y": 43}, "id": 20, "targets": [{"expr": "sum(kafka_consumergroup_lag{consumergroup=\"aggregator\"}) by (topic)", "legendFormat": "{{topic}}"}]}, {"type": "timeseries", "title": "Container CPU (cores)", "datasource": "Prometheus", "gridPos": {"h": 7, "w": 12, "x": 0, "y": 50}, "id": 21, "targets": [{"expr": "sum(rate(container_cpu_usage_seconds_total{image!=\"\", name=~\"advanta.*\"}[1m])) by (name)", "legendFormat": "{{name}}"}]}, {"type": "timeseries", "title": "Container memory (MiB)", "datasource": "Prometheus", "gridPos": {"h": 7, "w": 12, "x": 12, "y": 50}, "id": 22, "fieldConfig": {"defaults": {"unit": "mib"}, "overrides": []}, "targets": [{"expr": "sum(container_memory_usage_bytes{image!=\"\", name=~\"advanta.*\"}) by (name) / 1048576", "legendFormat": "{{name}}"}]}]}